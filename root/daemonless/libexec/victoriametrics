#!/bin/sh
# Start victoriametrics; /init has already dropped to the run user.

# Scrape targets are optional: VictoriaMetrics also accepts pushed metrics
SCRAPE=""
if [ -f /config/prometheus.yml ]; then
    SCRAPE="-promscrape.config=/config/prometheus.yml"
fi

# VM_EXTRA_ARGS is unquoted on purpose: it holds several flags
exec /usr/local/bin/victoria-metrics \
    -storageDataPath=/config/data \
    -httpListenAddr=:8428 \
    -retentionPeriod="${RETENTION_PERIOD:-1y}" \
    ${SCRAPE} \
    ${VM_EXTRA_ARGS}
